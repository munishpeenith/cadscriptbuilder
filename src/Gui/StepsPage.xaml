<UserControl x:Class="Gui.StepsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent"
             MouseDown="Page_MouseDown"
             PreviewKeyDown="Page_KeyDown">
    <Grid Margin="28,4,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title on the left, the connected drawing on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Build your steps" />
                <TextBlock x:Name="DrawingText"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Grid.Column="1"
                    Margin="0,20,0,0"
                    Padding="12,4,4,4"
                    VerticalAlignment="Top"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="#6CCB5F" />
                    <TextBlock x:Name="ConnectedText"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button x:Name="RefreshButton"
                               Margin="8,0,0,0"
                               Padding="8,4"
                               Appearance="Transparent"
                               Click="RefreshButton_Click"
                               Icon="{ui:SymbolIcon ArrowClockwise24}"
                               ToolTip="Refresh: rescan this drawing after changing it by hand" />
                    <ui:Button Margin="0,0,0,0"
                               Padding="8,4"
                               Appearance="Transparent"
                               Click="ChangeDrawing_Click"
                               Content="Change"
                               Icon="{ui:SymbolIcon ArrowSync24}"
                               ToolTip="Rescan, or switch to another drawing. Your steps are kept." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Pick a block, fill in its boxes, Add -->
        <ui:Card Grid.Row="1" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="BlockBox" Grid.Column="0" MaxDropDownHeight="420" />

                <!-- The layer box, with "Select" for picking several layers at once -->
                <DockPanel x:Name="FirstArea" Grid.Column="1" Margin="8,0,0,0">
                    <ui:Button x:Name="SelectButton"
                               Margin="6,0,0,0"
                               VerticalAlignment="Stretch"
                               DockPanel.Dock="Right"
                               Appearance="Secondary"
                               Click="SelectButton_Click"
                               Icon="{ui:SymbolIcon CheckboxChecked24}"
                               ToolTip="Select several layers at once" />
                    <ui:AutoSuggestBox x:Name="FirstBox"
                                       Icon="{ui:SymbolIcon ChevronDown24}"
                                       PreviewMouseLeftButtonUp="SuggestBox_Click" />
                </DockPanel>

                <ui:AutoSuggestBox x:Name="SecondBox" Grid.Column="2" Margin="8,0,0,0"
                                   Icon="{ui:SymbolIcon ChevronDown24}"
                                   PreviewMouseLeftButtonUp="SuggestBox_Click" />

                <ui:Button x:Name="AddButton"
                           Grid.Column="3"
                           Margin="8,0,0,0"
                           VerticalAlignment="Stretch"
                           Appearance="Primary"
                           Click="AddButton_Click"
                           Content="Add"
                           Icon="{ui:SymbolIcon Add24}"
                           IsDefault="True" />
            </Grid>
        </ui:Card>

        <!-- The steps, each with a tick or a cross -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="OpenButton"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Click="OpenPlan_Click"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               ToolTip="Open a saved plan" />
                    <ui:Button x:Name="SaveButton"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Click="SavePlan_Click"
                               Icon="{ui:SymbolIcon Save24}"
                               ToolTip="Save these steps as a plan, to reuse on other drawings" />
                    <ui:Button x:Name="ClearButton"
                               Margin="0,0,8,0"
                               Appearance="Secondary"
                               Click="ClearButton_Click"
                               Content="Clear all"
                               Icon="{ui:SymbolIcon Dismiss24}" />
                    <ui:Button x:Name="RemoveButton"
                               Appearance="Secondary"
                               Click="RemoveButton_Click"
                               Content="Remove"
                               Icon="{ui:SymbolIcon Delete24}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="Steps" />
            </DockPanel>

            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ui:ListView x:Name="StepsList"
                             Margin="4"
                             AllowDrop="True"
                             Background="Transparent"
                             BorderThickness="0"
                             DragOver="StepsList_DragOver"
                             Drop="StepsList_Drop"
                             KeyDown="StepsList_KeyDown"
                             MouseDoubleClick="StepsList_DoubleClick"
                             PreviewMouseLeftButtonDown="StepsList_MouseDown"
                             PreviewMouseMove="StepsList_MouseMove"
                             ToolTip="Drag to reorder · Delete to remove · Double-click to edit">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,6" Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               FontSize="18"
                                               Foreground="{Binding Color}"
                                               Symbol="{Binding Icon}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Text}" />
                            </StackPanel>
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>
            </Border>
        </Grid>

        <!-- Messages, and "Add anyway" when a step was held back -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <ui:Button x:Name="AddAnywayButton"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Right"
                       Appearance="Secondary"
                       Click="AddAnyway_Click"
                       Content="Add anyway"
                       Icon="{ui:SymbolIcon Add24}"
                       Visibility="Collapsed" />
            <ui:InfoBar x:Name="Status" IsClosable="False" IsOpen="True" />
        </DockPanel>

        <!-- Generate, and the RUN tile that appears once the script is ready -->
        <Grid Grid.Row="4" Height="64" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ⚙ Settings, bottom right -->
            <ui:Button x:Name="SettingsButton"
                       Grid.Column="2"
                       Width="40"
                       Height="40"
                       Margin="12,0,0,0"
                       Padding="0"
                       VerticalAlignment="Center"
                       Appearance="Transparent"
                       Click="SettingsButton_Click"
                       ToolTip="Settings">
                <ui:SymbolIcon FontSize="20" Symbol="Settings24" />
            </ui:Button>

            <ui:Button x:Name="GenerateButton"
                       Grid.Column="0"
                       Padding="22,12"
                       VerticalAlignment="Center"
                       Appearance="Primary"
                       Click="GenerateButton_Click"
                       Content="Generate script"
                       Icon="{ui:SymbolIcon Play24}" />

            <Border x:Name="RunTile"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Padding="16,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="10"
                    Cursor="Hand"
                    MouseMove="RunTile_MouseMove"
                    ToolTip="Drag me into your drawing"
                    Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,12,0"
                                   FontSize="30"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Symbol="Document24" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="RUN  ·  csb_run.lsp" />
                        <TextBlock FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Drag into Civil 3D to run it" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Settings: which blocks to show, plus advanced options. Opens upwards from the ⚙ -->
        <Popup x:Name="SettingsPopup"
               AllowsTransparency="True"
               HorizontalOffset="-280"
               Placement="Top"
               PlacementTarget="{Binding ElementName=SettingsButton}"
               StaysOpen="False">
            <Border Width="320"
                    Margin="0,0,0,6"
                    Padding="18,14"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SettingsPanel" Margin="0,0,10,0" />
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Refresh: a mini SCAN tile to drag into the drawing -->
        <Popup x:Name="RefreshPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RefreshButton}"
               StaysOpen="False">
            <Border Width="260"
                    Margin="0,6,0,0"
                    Padding="16"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <Border x:Name="RefreshTile"
                            Width="96"
                            Height="96"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                            BorderThickness="2"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseMove="RefreshTile_MouseMove"
                            ToolTip="Drag me into your drawing">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon HorizontalAlignment="Center"
                                           FontSize="32"
                                           Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                           Symbol="Document24" />
                            <TextBlock Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="SCAN" />
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,12,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Drag this into your drawing to refresh. Your steps are kept."
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Popup>

        <!-- The multi-select picker: tick layers, they're numbered in the order you tick them -->
        <Popup x:Name="PickerPopup"
               AllowsTransparency="True"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=FirstArea}"
               StaysOpen="False">
            <Border Width="380"
                    Margin="0,6,0,0"
                    Padding="12"
                    Background="{DynamicResource FlyoutBackground}"
                    BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel>
                    <ui:TextBox x:Name="PickerSearch" PlaceholderText="Search layers" />
                    <ScrollViewer MaxHeight="260"
                                  Margin="0,8,0,8"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PickerList" />
                    </ScrollViewer>
                    <DockPanel>
                        <ui:Button x:Name="PickerAddButton"
                                   DockPanel.Dock="Right"
                                   Appearance="Primary"
                                   Click="PickerAdd_Click"
                                   Content="Add"
                                   IsEnabled="False" />
                        <ui:Button Margin="0,0,8,0"
                                   DockPanel.Dock="Right"
                                   Appearance="Secondary"
                                   Click="PickerCancel_Click"
                                   Content="Cancel" />
                        <TextBlock x:Name="PickerCount"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Tick layers in the order you want them" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>