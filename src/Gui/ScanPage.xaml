<UserControl x:Class="Gui.ScanPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The main part: title, SCAN tile, status, Next -->
        <StackPanel Grid.Row="0" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock HorizontalAlignment="Center"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="CADScriptBuilder" />

            <TextBlock Margin="0,8,0,28"
                       HorizontalAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="To get started, drag this file into your Civil 3D drawing"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <!-- The SCAN tile: drag it out of the app into Civil 3D -->
            <Border x:Name="ScanTile"
                    Width="150"
                    Height="150"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="14"
                    Cursor="Hand"
                    MouseMove="ScanTile_MouseMove"
                    ToolTip="Drag me into your drawing">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:SymbolIcon HorizontalAlignment="Center"
                                   FontSize="48"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   Symbol="Document24" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="SCAN" />
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="csb_scan.lsp" />
                </StackPanel>
            </Border>

            <!-- Status: spinner while waiting, then a tick (or a cross) -->
            <StackPanel Height="30"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <ui:ProgressRing x:Name="WaitingRing"
                                 Width="20"
                                 Height="20"
                                 Margin="0,0,12,0"
                                 IsIndeterminate="True" />
                <ui:SymbolIcon x:Name="StatusIcon"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               FontSize="22"
                               Visibility="Collapsed" />
                <TextBlock x:Name="StatusText"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Waiting for scan..." />
            </StackPanel>

            <ui:Button x:Name="NextButton"
                       Margin="0,18,0,0"
                       Padding="32,8"
                       HorizontalAlignment="Center"
                       Appearance="Primary"
                       Click="NextButton_Click"
                       Content="Next"
                       Icon="{ui:SymbolIcon ArrowRight24}"
                       IsEnabled="False" />
        </StackPanel>

        <!-- What it can do: click to open, scroll through. Ticks = works now, clocks = coming -->
        <ui:CardExpander Grid.Row="1"
                         Margin="28,0,28,0"
                         Header="What CADScriptBuilder can do"
                         Icon="{ui:SymbolIcon Info24}">
            <ScrollViewer MaxHeight="170" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SupportPanel" Margin="0,0,12,0" />
            </ScrollViewer>
        </ui:CardExpander>
    </Grid>
</UserControl>
